file: src/lib.rs
properties: [nodes]

### Entity: Run
file: src/lib.rs
properties: [output, cycles]

### Entity: Workload
file: src/benchmarks.rs
properties: [id, program, expected_output, node_count, critical_path]

### Entity: CorpusSeal
file: scripts/verify-holdout.mjs
properties: [schema, case_count, corpus_sha256, evaluator_sha256, public_suite_sha256]
